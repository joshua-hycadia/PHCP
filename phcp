#==============================================================================
# phcp -- PHCP, the Python Hydraulic Calculation Program, from the
# command line: the former Perl program ported whole, same arguments,
# same printed lines, same JSON, same exit statuses.  Exit status is the
# contract other programs rely on:
#   0  ACCEPTED or NONCOMPLIANT    a valid solution
#   1  INDETERMINATE               did not converge or settle
#   2  input or topology error     nothing was solved
#   3  REJECTED                    converged, but fails a numerical or
#                                  physical check
#   4  NONCOMPLIANT, with --strict
#==============================================================================

import re
import sys

sys.path.insert(0, __import__('os').path.dirname(__import__('os').path.abspath(__file__)))

import hardycross as HardyCross
from hardycross import VERSION, GAMMA_W, solve_model, continuity_error, is_model_error
from hardycross import validate as _validate
from hardycross import jsonout

USAGE = 'usage: phcp [--json] [--strict] [--save] model.phc|- [report.txt|report.pdf] [--report report.pdf] [--annotate out.phc]\n'


def die(msg, err=None):
    # Perl's die: the message, then exit with errno when the failure set
    # one (2 for a missing folder, 13 for no permission), else 255.
    sys.stderr.write(msg)
    sys.stdout.flush()
    sys.exit((err.errno if err is not None and err.errno else 0) or 255)


def num(fmt, x):
    # printf of a number as Perl prints it: a flow that has run away to
    # not-a-number or infinity (a solve that diverged) is NaN, Inf or -Inf,
    # where Python's % gives nan, inf and -inf.
    if x != x:
        return 'NaN'
    if x in (float('inf'), float('-inf')):
        return 'Inf' if x > 0 else '-Inf'
    return fmt % x


def fail_out(e):
    if json:
        print(jsonout.encode(jsonout.error_result(e, model)), end='')
    sys.stderr.write('MODEL ERROR: %s\n' % (e.msg if is_model_error(e) else e))
    sys.exit(2)


def main():
    global json, model
    # Bytes out as the Perl wrote them (binmode STDOUT): LF on every
    # platform, and the model's own bytes back unchanged.
    sys.stdout.reconfigure(encoding='utf-8', errors='surrogateescape', newline='\n')
    sys.stderr.reconfigure(encoding='utf-8', errors='surrogateescape')
    json = 0
    model = report_path = annotate = None
    save = strict = 0
    argv = sys.argv[1:]
    while argv:
        a = argv.pop(0)
        if a == '--json':
            json = 1
        elif a == '--save':
            save = 1
        elif a == '--strict':
            strict = 1
        elif a == '--report':
            if not argv:
                die(USAGE)
            report_path = argv.pop(0)
        elif a == '--annotate':
            if not argv:
                die(USAGE)
            annotate = argv.pop(0)
        elif model is None:
            model = a
        elif report_path is None:
            report_path = a
        else:
            die(USAGE)
    if model is None:
        die(USAGE)

    from hardycross.parse import read_model
    from hardycross.phc import read_string
    try:
        if model == '-':
            from hardycross.phc import model_text
            text = model_text(sys.stdin.buffer.read())
            # A supply graph (SUPPLYGRAPH) is then found from the current folder.
            net = read_string(text, '.')
        else:
            net = read_model(model)
    except Exception as e:
        fail_out(e)
    try:
        ok = solve_model(net)
    except Exception as e:
        fail_out(e)
    # Pipes given size 0 are sized, then, with design areas (AREA), each area
    # is solved and the governing one reported.
    if net.get('auto_sizing'):
        from hardycross import sizing
        text = net.get('source_text')
        try:
            net, ok = sizing.size(net, ok)
        except Exception as e:
            fail_out(e)
        if annotate is not None:
            try:
                af = open(annotate, 'w', encoding='utf-8', errors='surrogateescape')
            except OSError as e:
                die('cannot write %s: %s\n' % (annotate, e.strerror), e)
            with af:
                af.write(sizing.annotate(text, net['sizing']))
    if net.get('areas'):
        from hardycross import areas
        try:
            net, ok = areas.governing(net, ok)
        except Exception as e:
            fail_out(e)

    # With a report path, write the full calculation report there.
    if report_path is not None:
        from hardycross import report
        name = 'STDIN.PHC' if model == '-' else model
        # /\.pdf$/i in Perl: $ also matches before a newline that ends the name.
        if re.search(r'\.pdf$', report_path, re.I):
            try:
                report.write_pdf_report(net, ok, name, report_path)
            except OSError as e:
                die('cannot write %s: %s\n' % (report_path, e.strerror), e)
        else:
            try:
                rf = open(report_path, 'w', encoding='utf-8', errors='surrogateescape')
            except OSError as e:
                die('cannot write %s: %s\n' % (report_path, e.strerror), e)
            with rf:
                rf.write(report.write_report(net, ok, name))

    # --save: the results back into the model file, as comments at its end.
    if save:
        if model == '-':
            die('--save needs a model file, not standard input\n')
        from hardycross import results
        from hardycross.phc import model_text
        try:
            with open(model, 'rb') as fh:
                text = model_text(fh.read())
        except OSError as e:
            die('cannot read %s: %s\n' % (model, e.strerror), e)
        text = text.replace('\r\n', '\n')
        try:
            out = open(model, 'w', encoding='utf-8', errors='surrogateescape', newline='\n')
        except OSError as e:
            die('cannot write %s: %s\n' % (model, e.strerror), e)
        with out:
            out.write(results.with_results(text, net, ok))

    if json:
        j = jsonout.results(net, ok, model)
        sys.stdout.write(jsonout.encode(j))
        sys.exit(jsonout.exit_code(j['acceptance'], strict))
    # Without --json the acceptance is still worked out (with the demand
    # point only when a report asked for it, as it re-solves the model many
    # times), so the exit status means the same thing either way.
    with_demand = 1 if (report_path is not None or strict or save) else 0
    va = _validate.assess(net, ok, demand=with_demand)['validation']

    sys.stdout.write('# PHCP - Python Hydraulic Calculation Program %s\n' % VERSION)
    sys.stdout.write('# converged %s  iterations %d  loops %d  continuity %s\n'
                     % ('yes' if ok else 'NO', net['iters'], len(net['loops']),
                        num('%.4e', continuity_error(net))))
    sys.stdout.write('# units flow %s pressure %s\n' % (net['u_flow'], net['u_pres']))
    sys.stdout.write('# acceptance %s%s\n'
                     % (va['acceptance'],
                        '' if with_demand
                        else ' (supply demand not assessed: use --strict, --json or a report)'))
    for ei in range(1, len(net['elems'])):
        e = net['elems'][ei]
        sys.stdout.write('Q %s %s\n' % (e['id'], num('%.4f', e['q'] / net['f_flow'])))
    for i in range(1, len(net['nodes'])):
        n = net['nodes'][i]
        if n['id'] == 'REF':
            continue
        sys.stdout.write('P %s %s\n'
                         % (n['id'], num('%.4f', (n['h'] - GAMMA_W * n['z']) / net['f_pres'])))
    sys.exit(jsonout.exit_code(va['acceptance'], strict))


if __name__ == '__main__':
    main()
