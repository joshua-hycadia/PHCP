! ---------------------------------------------------------------------------
! 01 - single branch validation case
! Static 900 kPa supply -> 100 m of DN100 (C=120) -> one K80 sprinkler.
! Closed-form answer: Q = 80*sqrt(900 - 1.5689e-4*Q^1.85)  ->  Q ~ 2090 L/min
! ---------------------------------------------------------------------------
UNITS
  FLOW      LPM
  PRESSURE  KPA
  LENGTH    M
  DIAMETER  MM
END

OPTIONS
  METHOD    HW
  TRACE     FULL
  TOL_FLOW  0.001
  TOL_LOOP  0.0005
END

NODES
  N1   0.0
  N2   0.0
END

PIPES
  P1   N1  N2   100.0  100.0  120
END

SUPPLIES
  SUP1 N1  STATIC  900
END

DISCHARGES
  S1   N2  SPRINKLER  K=80  P=50
END
