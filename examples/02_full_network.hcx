! ---------------------------------------------------------------------------
! 02 - full feature demonstration
!
!   two supplies : tank + booster pump, and a town main on a falling curve
!   pressure devices : BFP loss curve, PRV fixed drop, both orifice modes
!   discharges : sprinklers, hydrant, hose reel, fixed-flow outlet
!   two real loops in the grid plus the pseudo-loop between the supplies
! ---------------------------------------------------------------------------
PROJECT
  TITLE       Combined sprinkler and hydrant network - worked example
  PROJECT     Hardy Cross solver demonstration model
  JOB         HC-DEMO-002
  DESIGNER    A Designer
  REVISION    A
  DATE        2026-09-10
  STANDARD    AS 2118.1
  DATA_SOURCE Hycadia pipe and fitting database - pipe dimensions and fitting equivalent lengths
END

UNITS
  FLOW      LPM
  PRESSURE  KPA
  LENGTH    M
  DIAMETER  MM
END

OPTIONS
  METHOD    HW
  TRACE     SUMMARY
  TOL_FLOW  0.01
  TOL_LOOP  0.005
  MAXITER   3000
END

NODES
  T1    0.0        ! tank / pump suction
  J1    0.0        ! pump discharge
  J2    0.0        ! downstream of backflow preventer
  TM    0.0        ! town main connection
  K1    0.0        ! downstream of PRV
  A    10.0
  B    10.0
  C    10.0
  D    10.0
  HY   10.0
  X    10.0
  X2   10.0
  Y    10.0
  Y2   10.0
END

PIPES
  M1    J2  A    30.0  150.0  120   EQV=8.0
  M2    K1  B    60.0  150.0  120   EQV=12.0
  G1    A   B    40.0  100.0  120
  G2    B   C    40.0  100.0  120
  G3    C   D    40.0  100.0  120
  G4    D   A    40.0  100.0  120
  G5    A   C    55.0   80.0  120
  BR1   D   X    10.0   50.0  120
  BR2   C   Y    12.0   50.0  120
  BR3   C   HY   15.0  100.0  120
END

PUMPS
! id    n1  n2   q1 p1     q2 p2      q3 p3
  PMP1  T1  J1   0  850    2500 800   4000 600
END

SUPPLIES
  SUP1  T1  STATIC  200
  SUP2  TM  CURVE   0 1000   3000 700   6000 300
END

DEVICES
! backflow preventer, loss curve
  BFP1  J1  J2  BFP  0 0   1000 25   2000 55   3000 95
! fixed drop pressure reducing valve
  PRV1  TM  K1  PRV  DP=150
! orifice plate sized to give a fixed net drop (AS 2118.1 App B)
  OP1   X   X2  ORIFICE_P  DP=80  DN=50
! orifice plate of known bore, drop computed
  OP2   Y   Y2  ORIFICE_D  BORE=22  DN=50
END

DISCHARGES
  S1    X2  SPRINKLER  K=80   P=50
  S2    Y2  SPRINKLER  K=115  Q=225
  HYD1  HY  HYDRANT    Q=1200 P=250
  HR1   A   HOSEREEL   K=7.5  P=220
  FF1   B   FIXEDFLOW  Q=300  MINP=200
END
